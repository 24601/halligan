{
  "name": "learn-tree-admission-credential",
  "behaviour": "admission",
  "description": "The credential tripwire across all three entry kinds, in both forms: a key whose NAME ends in a credential word, and a value whose SHAPE is a known credential literal — including model-authored free text. A tree persists verbatim into every release and every delivered copy, so a credential that reaches an entry reaches version history.",
  "entries": [
    {
      "case": "clean instruction",
      "entry": {
        "id": "clean-instruction",
        "kind": "instruction",
        "config": { "text": "Answer in one short paragraph." }
      },
      "expected": { "admitted": true, "reasons": [] }
    },
    {
      "case": "clean bullet",
      "entry": {
        "id": "clean-bullet",
        "kind": "playbookBullet",
        "config": {
          "id": "be-brief",
          "section": "General",
          "content": "Prefer the shortest correct answer.",
          "tags": ["style"]
        }
      },
      "expected": { "admitted": true, "reasons": [] }
    },
    {
      "case": "clean skill",
      "entry": {
        "id": "clean-skill",
        "kind": "skill",
        "config": {
          "skillId": "rollback-drill",
          "name": "Rollback drill",
          "content": "Promote the previous release, then verify."
        }
      },
      "expected": { "admitted": true, "reasons": [] }
    },
    {
      "case": "credential-named key on a bullet",
      "entry": {
        "id": "keyed-bullet",
        "kind": "playbookBullet",
        "config": {
          "id": "keyed",
          "section": "General",
          "content": "ordinary text",
          "apiKey": "whatever"
        }
      },
      "expected": {
        "admitted": false,
        "reasons": [
          { "reason": "forbidden-or-unknown", "path": "config.apiKey" },
          { "reason": "inline-credential", "path": "config.apiKey" }
        ]
      }
    },
    {
      "case": "openai literal in instruction free text",
      "entry": {
        "id": "sk-instruction",
        "kind": "instruction",
        "config": { "text": "Call the API with sk-abcdefghij0123456789." }
      },
      "expected": {
        "admitted": false,
        "reasons": [
          { "reason": "credential-shaped-literal", "path": "config.text" }
        ]
      }
    },
    {
      "case": "github literal in skill content",
      "entry": {
        "id": "ghp-skill",
        "kind": "skill",
        "config": {
          "skillId": "deploy",
          "name": "Deploy",
          "content": "Authenticate with ghp_abcdefghij0123456789abcd first."
        }
      },
      "expected": {
        "admitted": false,
        "reasons": [
          { "reason": "credential-shaped-literal", "path": "config.content" }
        ]
      }
    },
    {
      "case": "private key header in bullet content",
      "entry": {
        "id": "pem-bullet",
        "kind": "playbookBullet",
        "config": {
          "id": "pem",
          "section": "General",
          "content": "-----BEGIN RSA PRIVATE KEY----- keep this handy"
        }
      },
      "expected": {
        "admitted": false,
        "reasons": [
          { "reason": "credential-shaped-literal", "path": "config.content" }
        ]
      }
    },
    {
      "case": "opaque run beside a credential word in a tag",
      "entry": {
        "id": "tagged-bullet",
        "kind": "playbookBullet",
        "config": {
          "id": "tagged",
          "section": "General",
          "content": "ordinary text",
          "tags": ["token 0123456789abcdef0123456789abcdef01234567"]
        }
      },
      "expected": {
        "admitted": false,
        "reasons": [
          { "reason": "credential-shaped-literal", "path": "config.tags[0]" }
        ]
      }
    },
    {
      "case": "proposer-authored bullet evidence",
      "entry": {
        "id": "evidence-bullet",
        "kind": "playbookBullet",
        "config": {
          "id": "claims-its-own-merit",
          "section": "General",
          "content": "ordinary text",
          "helpfulCount": 99,
          "evidence": { "confidence": 1 }
        }
      },
      "expected": {
        "admitted": false,
        "reasons": [
          { "reason": "forbidden-bullet-field", "path": "config.helpfulCount" },
          { "reason": "forbidden-bullet-field", "path": "config.evidence" }
        ]
      }
    }
  ],
  "expectedReportOk": false
}
