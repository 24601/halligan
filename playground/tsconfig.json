{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    // `noUnusedLocals` / `noUnusedParameters` are deliberately OFF here: this
    // project also type-checks the aliased `src/ax` source, which is built with
    // the repo's own tsconfig and carries intentional unused bindings. Biome's
    // `noUnusedVariables` covers `playground/src`, which is the code this lane
    // owns.
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@ax-llm/ax": ["../src/ax/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "e2e/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
