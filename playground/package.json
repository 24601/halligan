{
  "name": "@ax-llm/ax-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pry - the halligan playground. Live halligan subsystems, running in your tab.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
