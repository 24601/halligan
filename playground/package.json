    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@lucide/vue": "1.39.0",
    "minisearch": "7.2.0",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "6.0.8",
    "vite": "8.2.2",
    "vue-tsc": "3.3.11"
  }
}
