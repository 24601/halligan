      "steps": [
        {
          "stepId": "s11",
          "trajectoryId": "traj",
          "seq": 11,
          "type": "message",
          "ts": 1011,
          "data": {
            "from": "mind",
            "to": "ada",
            "content": "not ours",
            "replyTo": "s10"
          },
          "source": "chat"
        }
