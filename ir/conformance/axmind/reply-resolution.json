      "expected": {
        "state": "unanswered",
        "failedOpen": false
      }
    },
    {
      "row": 2,
      "name": "a settled send effect under this trigger's key answers it",
      "steps": [],
      "options": {
        "settledSendKeys": ["ax.mind.chat:abc"],
        "triggerKey": "ax.mind.chat:abc"
      },
      "expected": {
        "state": "answered",
        "failedOpen": false
      }
    },
    {
      "row": 3,
