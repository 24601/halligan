  "cases": [
    {
      "row": 1,
      "name": "an outbound message from us stamped replyTo answers it",
      "steps": [
        {
          "stepId": "s11",
          "trajectoryId": "traj",
          "seq": 11,
          "type": "message",
          "ts": 1011,
          "data": {
            "from": "mind",
            "to": "ada",
            "content": "yes",
            "replyTo": "s10"
          },
          "source": "responder"
        }
      ],
      "expected": {
        "state": "answered",
        "evidenceStepId": "s11",
        "failedOpen": false
      }
    },
    {
      "row": 1,
